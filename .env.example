# Database Credentials
DB_HOST=your_postgresql_host
DB_PORT=your_postgresql_port
DB_NAME=database_name
DB_USERNAME=your_username
DB_PASSWORD=your_actual_password

# Authentication JWT
JWT_SECRET=your_jwt_secret_with_openssl

# CORS
FRONTEND_URL=url_to_the_frontend_web_app

# ADMIN SEED CREDENTIALS
SEED_ADMIN_EMAIL=your_admin_email
SEED_ADMIN_PASSWORD=your_admin_password

# SPRING
# Production: set the real server environment variable SPRING_PROFILES_ACTIVE=prod
# (not in this file). Without it, the dev profile is the default and seeds an admin.
SPRING_PROFILES_ACTIVE=null #at production, to prevent dev n prod collisions

# File Upload directory
UPLOAD_DIR=./uploads